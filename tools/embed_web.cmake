# Writes every file under WEB_DIR into OUTPUT, a C++ source defining bitzkey::daemon::web_assets():
# each file's path (from WEB_DIR, with forward slashes) and its bytes. Run by the build.
file(GLOB_RECURSE files RELATIVE "${WEB_DIR}" "${WEB_DIR}/*")
list(SORT files)
set(body "")
set(entries "")
set(index 0)
foreach(file IN LISTS files)
    file(READ "${WEB_DIR}/${file}" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR size "${length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "static const unsigned char asset_${index}[] = {${bytes}0};\n")
    string(APPEND entries "        {\"${file}\", std::string_view(reinterpret_cast<const char*>(asset_${index}), ${size})},\n")
    math(EXPR index "${index} + 1")
endforeach()
file(WRITE "${OUTPUT}.tmp" "// Generated by tools/embed_web.cmake from web/; do not edit.
#include <map>
#include <string>
#include <string_view>

namespace bitzkey::daemon {

${body}
const std::map<std::string, std::string_view>& web_assets() {
    static const std::map<std::string, std::string_view> assets = {
${entries}    };
    return assets;
}

}  // namespace bitzkey::daemon
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
