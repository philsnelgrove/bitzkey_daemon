#version 450
#extension GL_GOOGLE_include_directive : require
// Every brain asked values each action at once: one workgroup a brain, its threads a layer's neurons.

layout(local_size_x = 64) in;
#include "brain.glsl"

layout(std430, binding = 0) readonly buffer Weights { float weights[]; };
layout(std430, binding = 1) readonly buffer Slots { uint slots[]; };    // the brain each request asks
layout(std430, binding = 2) readonly buffer Inputs { float inputs[]; }; // INPUTS senses a request
layout(std430, binding = 3) writeonly buffer Values { float values[]; }; // ACTIONS values a request

shared float layers[2][INPUTS];
#define SENSE(item) layers[0][item]
// The senses not 0, in order: the first layer passes over only them, its sums the same to the bit (a term of 0 adds
// nothing), and a lesson moves only their weights (a sense of 0 moves its weight by nothing). Each thread counts its
// stretch, the first adds the counts up, and each writes its stretch's after those before it.
shared uint nonzero[INPUTS];
shared uint nonzero_count;
shared uint stretch_from[THREADS];
void compact(uint thread, uint stretch) {
    const uint from = thread * stretch, to = min(INPUTS, from + stretch);
    uint count = 0u;
    for (uint item = from; item < to; ++item) count += SENSE(item) != 0.0 ? 1u : 0u;
    stretch_from[thread] = count;
    barrier();
    if (thread == 0u) {
        uint total = 0u;
        for (uint each = 0u; each < THREADS; ++each) {
            const uint counted = stretch_from[each];
            stretch_from[each] = total;
            total += counted;
        }
        nonzero_count = total;
    }
    barrier();
    uint at = stretch_from[thread];
    for (uint item = from; item < to; ++item) {
        if (SENSE(item) != 0.0) nonzero[at++] = item;
    }
    barrier();
}

void main() {
    const uint request = push.first + gl_WorkGroupID.x;
    if (request >= push.first + push.count) return;
    const uint thread = gl_LocalInvocationID.x;
    const uint base = slots[request] * push.slot_floats;
    for (uint item = thread; item < INPUTS; item += THREADS) layers[0][item] = inputs[request * INPUTS + item];
    barrier();
    compact(thread, (INPUTS + THREADS - 1u) / THREADS);
    uint below = 0u;
    for (uint layer = 0u; layer < push.depth; ++layer) {
        const uint reads = reads_of(layer);
        const uint row = weights_of(base, layer);
        if (thread < push.width) {
            float sum = 0.0;
            if (layer == 0u) {
                for (uint k = 0u; k < nonzero_count; ++k) {
                    const uint item = nonzero[k];
                    sum += weights[row + item * push.width + thread] * layers[0][item];
                }
            } else {
                for (uint item = 0u; item < reads; ++item) sum += weights[row + item * push.width + thread] * layers[below][item];
            }
            layers[1u - below][thread] = tanh(sum + weights[biases_of(base) + layer * push.width + thread]);
        }
        barrier();
        below = 1u - below;
    }
    for (uint value = thread; value < ACTIONS; value += THREADS) {  // more outputs than threads: each thread takes several
        float sum = 0.0;
        for (uint neuron = 0u; neuron < push.width; ++neuron) sum += weights[outputs_of(base) + neuron * ACTIONS + value] * layers[below][neuron];
        values[request * ACTIONS + value] = (sum + weights[output_biases_of(base) + value]) / VALUE_SCALE;
    }
}
